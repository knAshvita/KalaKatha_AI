# ─────────────────────────────────────────────
#  KalaKatha AI – Environment Variables
# ─────────────────────────────────────────────

# Required: Get your key at https://aistudio.google.com/app/api-keys
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the Gemini model used by Google ADK agents
GEMINI_MODEL=gemini-3.5-flash

# Optional: CORS origins for the React frontend (comma-separated)
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional: Max file size for artwork uploads (bytes, default 10 MB)
# MAX_UPLOAD_SIZE_BYTES=10485760
